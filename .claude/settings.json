      "Bash(git push origin main:*)",
      "Bash(git tag:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh release create:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(docker login:*)",
      "Bash(op:*)"
    ]
  }
}
